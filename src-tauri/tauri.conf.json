{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Collection Tracker",
  "version": "0.1.0",
  "identifier": "com.the1azreen.collectiontracker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Collection Tracker",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
